# ----------------------------------------------------------------------------
# B14-B17. One dept-emp query with inner and outer joins.
#
# The query computes the payroll per department as a ratio of two measures
# from different relations: AGG(e.sum_sal) / AGG(d.dept_count). The join
# repeats each dept row once for each employee in it (fan-out), but
# dept_count still counts each department once. Naive COUNT(d.deptno) is 14
# for INNER and 15 for LEFT.
#
# The join type is the tool's choice, and it changes the answer (spec 10.2,
# A.6). The LEFT join keeps OPERATIONS, which has no employees, so the
# payroll is divided by 4 departments and not by 3. A filter in the ON clause
# of the LEFT join keeps all 4 departments but matches only the clerks.
# A RIGHT join with the sides swapped, or a FULL join, gives the LEFT
# result, because every employee has a department.
# Spec: 7.2, 7.6, 8.1, A.6
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# B14. A ratio of measures from two relations.
# Question: What is the payroll per department, over the departments that
#   have employees?
# B14 to B16 run one dept-emp query with different joins. The query divides
# the payroll by the number of departments: a ratio of two measures from
# different relations. The join repeats each dept row once for each employee
# in the department, but dept_count still counts each department once. The
# CAST makes the division approximate (README, "Result semantics").
#
# A plain COUNT(d.deptno) over the joined rows gives 14, not 3.
# Spec: 7.2, 7.6, 8.1, A.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(d.dept_count) AS dept_count,
         AGG(e.emp_count) AS emp_count,
         AGG(e.sum_sal) AS sum_sal,
         CAST(AGG(e.sum_sal) AS DOUBLE) / AGG(d.dept_count) AS sal_per_dept
  FROM scott_model.dept AS d
  JOIN scott_model.emp AS e ON e.deptno = d.deptno);
> {_|
WITH joined AS (
  SELECT
    d.deptno AS d_k,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.dept AS d
  JOIN scott.emp AS e
    ON e.deptno = d.deptno
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  CAST((
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS DOUBLE) / (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS sal_per_dept
|_} : string
+------------+-----------+----------+--------------+
| dept_count | emp_count | sum_sal  | sal_per_dept |
+------------+-----------+----------+--------------+
|          3 |        14 | 29025.00 |      9675.00 |
+------------+-----------+----------+--------------+

# ----------------------------------------------------------------------------
# B15. A LEFT JOIN keeps an empty department, and the ratio changes.
# Question: What is the payroll per department, over all departments?
# B14 to B16 run one dept-emp query with different joins. The query divides
# the payroll by the number of departments: a ratio of two measures from
# different relations. The join repeats each dept row once for each employee
# in the department, but dept_count still counts each department once. The
# CAST makes the division approximate (README, "Result semantics").
#
# OPERATIONS has no employees. The LEFT join keeps it, so the payroll is
# divided by 4 departments and not by 3 (B14). The join type is the choice of
# the tool, and it changes the answer (Sections 10.2 and A.6). A plain
# COUNT(d.deptno) over the joined rows gives 15, not 4. A RIGHT join with the
# sides swapped, or a FULL join, gives the same result, because every
# employee has a department.
# Spec: 7.2, 7.6, 8.1, 10.2, A.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(d.dept_count) AS dept_count,
         AGG(e.emp_count) AS emp_count,
         AGG(e.sum_sal) AS sum_sal,
         CAST(AGG(e.sum_sal) AS DOUBLE) / AGG(d.dept_count) AS sal_per_dept
  FROM scott_model.dept AS d
  LEFT JOIN scott_model.emp AS e ON e.deptno = d.deptno);
> {_|
WITH joined AS (
  SELECT
    d.deptno AS d_k,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.dept AS d
  LEFT JOIN scott.emp AS e
    ON e.deptno = d.deptno
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  CAST((
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS DOUBLE) / (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS sal_per_dept
|_} : string
+------------+-----------+----------+--------------+
| dept_count | emp_count | sum_sal  | sal_per_dept |
+------------+-----------+----------+--------------+
|          4 |        14 | 29025.00 |      7256.25 |
+------------+-----------+----------+--------------+

# ----------------------------------------------------------------------------
# B16. A filter in the ON clause of a LEFT JOIN keeps every left row.
# Question: What is the payroll of the clerks per department, over all
#   departments?
# B14 to B16 run one dept-emp query with different joins. The query divides
# the payroll by the number of departments: a ratio of two measures from
# different relations. The join repeats each dept row once for each employee
# in the department, but dept_count still counts each department once. The
# CAST makes the division approximate (README, "Result semantics").
#
# The condition e.job = 'CLERK' in ON keeps every department and matches only
# clerks. If the condition were in WHERE, the query would remove the
# NULL-padded OPERATIONS row, and dept_count would be 3.
# Spec: 7.2, 7.6, 8.1, A.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(d.dept_count) AS dept_count,
         AGG(e.emp_count) AS emp_count,
         AGG(e.sum_sal) AS sum_sal,
         CAST(AGG(e.sum_sal) AS DOUBLE) / AGG(d.dept_count) AS sal_per_dept
  FROM scott_model.dept AS d
  LEFT JOIN scott_model.emp AS e ON e.deptno = d.deptno AND e.job = 'CLERK');
> {_|
WITH joined AS (
  SELECT
    d.deptno AS d_k,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.dept AS d
  LEFT JOIN scott.emp AS e
    ON e.deptno = d.deptno AND e.job = 'CLERK'
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  CAST((
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS DOUBLE) / (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS sal_per_dept
|_} : string
+------------+-----------+---------+--------------+
| dept_count | emp_count | sum_sal | sal_per_dept |
+------------+-----------+---------+--------------+
|          4 |         4 | 4150.00 |      1037.50 |
+------------+-----------+---------+--------------+

# ----------------------------------------------------------------------------
# B17. LEFT JOIN, grouped: a group with an empty input set.
# Question: For each department, including a department with no employees,
#   what are the headcount, the payroll, and the average salary?
# The B15 query, grouped by department. The OPERATIONS group stays in the
# result. Its joined row is NULL-padded on the emp side, so the emp measures
# take their empty-input values: 0 for COUNT, NULL for SUM and AVG. The INNER
# join of B1 omits OPERATIONS.
# Spec: 7.6, 8.1, A.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT d.dname,
         AGG(e.emp_count) AS emp_count,
         AGG(e.sum_sal) AS sum_sal,
         AGG(e.avg_sal) AS avg_sal
  FROM scott_model.dept AS d
  LEFT JOIN scott_model.emp AS e ON e.deptno = d.deptno
  GROUP BY d.dname
  ORDER BY d.dname);
> {_|
WITH joined AS (
  SELECT
    d.dname AS dname,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.dept AS d
  LEFT JOIN scott.emp AS e
    ON e.deptno = d.deptno
), spine AS (
  SELECT DISTINCT
    dname
  FROM joined
)
SELECT
  g.dname,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.dname IS NOT DISTINCT FROM g.dname
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.dname IS NOT DISTINCT FROM g.dname
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  (
    SELECT
      AVG(CAST(x.sal AS DOUBLE))
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.dname IS NOT DISTINCT FROM g.dname
      GROUP BY
        j.e_k
    ) AS x
  ) AS avg_sal
FROM spine AS g
ORDER BY
  g.dname
|_} : string
+------------+-----------+----------+---------+
| dname      | emp_count | sum_sal  | avg_sal |
+------------+-----------+----------+---------+
| ACCOUNTING |         3 |  8750.00 | 2916.67 |
| OPERATIONS |         0 |          |         |
| RESEARCH   |         5 | 10875.00 | 2175.00 |
| SALES      |         6 |  9400.00 | 1566.67 |
+------------+-----------+----------+---------+

# ----------------------------------------------------------------------------
# B18. WHERE restricts a "one"-side measure that the join fans out.
# Question: Among the employees who earn more than 1000, how many
#   departments have each job, and how many such employees are there?
# The join repeats each dept row once for each employee in the department,
# and WHERE removes rows before the measures are evaluated. AGG(d.dept_count)
# counts each surviving department once in each group. Removing the two
# lowest-paid clerks (SMITH and JAMES) drops CLERK from three departments to
# two. A plain COUNT(*) over the joined rows gives 2, 2, 3, 1, 4.
# AGG(e.emp_count) gives the same values, because the join repeats no emp row.
# Spec: 7.3, 7.6, G1 (8.2), G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job,
         AGG(d.dept_count) AS dept_count,
         AGG(e.emp_count) AS emp_count
  FROM scott_model.emp AS e
  JOIN scott_model.dept AS d ON e.deptno = d.deptno
  WHERE e.sal > 1000
  GROUP BY e.job
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    d.deptno AS d_k,
    e.empno AS e_k
  FROM scott.emp AS e
  JOIN scott.dept AS d
    ON e.deptno = d.deptno
  WHERE
    e.sal > 1000
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count
FROM spine AS g
ORDER BY
  g.job
|_} : string
+-----------+------------+-----------+
| job       | dept_count | emp_count |
+-----------+------------+-----------+
| ANALYST   |          1 |         2 |
| CLERK     |          2 |         2 |
| MANAGER   |          3 |         3 |
| PRESIDENT |          1 |         1 |
| SALESMAN  |          1 |         4 |
+-----------+------------+-----------+

# ----------------------------------------------------------------------------
# B19. A join to a non-distinct filter relation does not inflate a measure.
# Question: In the departments that have a salesman, what is the payroll of
#   each job?
# The subquery lists the department of each salesman. Only department 30 has
# a salesman, and the subquery returns it four times, once per salesman. The
# join repeats each employee of department 30 four times, but AGG(e.sum_sal)
# counts each employee once. A plain SUM(e.sal) over the joined rows gives
# 3800, 11400, 22400. Here the duplication comes from the filter relation,
# not from a finer-grained table (B6), and G2 still counts each source row
# once.
# Spec: 7.6, 8.4, G2 (8.3), A.2
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job, AGG(e.sum_sal) AS sum_sal
  FROM scott_model.emp AS e
  JOIN (SELECT deptno
        FROM scott_model.emp
        WHERE job = 'SALESMAN') AS t ON e.deptno = t.deptno
  GROUP BY e.job
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.emp AS e
  JOIN (
    SELECT
      deptno
    FROM scott.emp
    WHERE
      job = 'SALESMAN'
  ) AS t
    ON e.deptno = t.deptno
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal
FROM spine AS g
ORDER BY
  g.job
|_} : string
+----------+---------+
| job      | sum_sal |
+----------+---------+
| CLERK    |  950.00 |
| MANAGER  | 2850.00 |
| SALESMAN | 5600.00 |
+----------+---------+

# ----------------------------------------------------------------------------
# B20. HAVING on a "one"-side measure that the join fans out.
# Question: Which jobs exist in more than one department, and in how many?
# AGG(d.dept_count) may appear in HAVING, as any aggregate may (Section 7.5).
# The join repeats each dept row once for each employee, and the measure
# counts each department once, so HAVING keeps the jobs that span more than
# one department: CLERK and MANAGER. A plain COUNT(*) > 1 in HAVING would use
# the joined-row count and also keep ANALYST (2) and SALESMAN (4), whose
# employees are all in one department.
# Spec: 7.5, 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job, AGG(d.dept_count) AS dept_count
  FROM scott_model.emp AS e
  JOIN scott_model.dept AS d ON e.deptno = d.deptno
  GROUP BY e.job
  HAVING AGG(d.dept_count) > 1
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    d.deptno AS d_k
  FROM scott.emp AS e
  JOIN scott.dept AS d
    ON e.deptno = d.deptno
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count
FROM spine AS g
WHERE
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.d_k
    ) AS x
  ) > 1
ORDER BY
  g.job
|_} : string
+---------+------------+
| job     | dept_count |
+---------+------------+
| CLERK   |          3 |
| MANAGER |          3 |
+---------+------------+

# End relational_semantics.ost
