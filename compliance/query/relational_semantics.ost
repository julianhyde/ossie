# ============================================================================
# Compliance queries: Relational Query Interface (Layer 2)
#
# Test cases for core-spec/relational_semantics.md over the classic SCOTT
# schema. Each case has three parts:
#   1. An Ossie query that evaluates measures with AGG(), the argument to
#      executeExpand.
#   2. Its expansion into an equivalent DuckDB query over the base tables
#      (apache/ossie#502).
#   3. The result of executing the expansion.
#
# Part A covers the fundamentals on one relation. Part B covers joins.
#
# The cases are those of cases/*/query.ossie.sql (see README.md), and the
# model is scott/scott_model.ossie.yaml. Cases B5a, B8a, B8b and B9a to
# B13a, which use the datasets pet and bonus, are not in cases/.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/query
#
# Expected-result format:
#   * NULL is shown as an empty cell.
#   * DOUBLE values are rounded to 2 decimal places.
#
# References:
#   * Spec: core-spec/relational_semantics.md (apache/ossie#354)
#   * Dataset-scoped metrics: apache/ossie#591
#   * Test format: apache/ossie#501. View expander: apache/ossie#502.
# ============================================================================


# ============================================================================
# Data: the SCOTT schema
#
# The "scott" fixture has tables dept, emp, bonus, salgrade and pet in
# schema scott, with the same values as scott/scott.sql.
# ============================================================================

connect("scott");
set("doubleDigits", 2);


# ============================================================================
# Model: Ossie semantic model over SCOTT
#
# The model is scott/scott_model.ossie.yaml; its comments describe it. Each
# dataset is a relation in schema scott_model, such as scott_model.emp.
# ============================================================================

modelFile("scott_model", "scott/scott_model.ossie.yaml");


# ============================================================================
# Part A: fundamentals (one relation)
#
# On one relation, no join repeats rows. So AGG(m) gives the same result as
# the metric's aggregate over the same rows.
# ============================================================================

# ----------------------------------------------------------------------------
# A1. Grand total.
# Question: What is the total salary, and how many employees are there?
# AGG() is an aggregate. Without GROUP BY, the query returns one row.
# Spec: 6, 7.2
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(sum_sal) AS sum_sal,
         AGG(emp_count) AS emp_count
  FROM scott_model.emp);
> {_|
SELECT
  SUM(sal) AS sum_sal,
  COUNT(*) AS emp_count
FROM scott.emp
|_} : string
+----------+-----------+
| sum_sal  | emp_count |
+----------+-----------+
| 29025.00 |        14 |
+----------+-----------+

# ----------------------------------------------------------------------------
# A2. A measure is evaluated for each group.
# Question: What are the payroll and the headcount of each department?
# The grouping sets the level at which each measure is reported.
# Spec: 7.4, G1 (8.2)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT deptno,
         AGG(sum_sal) AS sum_sal,
         AGG(emp_count) AS emp_count
  FROM scott_model.emp
  GROUP BY deptno
  ORDER BY deptno);
> {_|
SELECT
  deptno,
  SUM(sal) AS sum_sal,
  COUNT(*) AS emp_count
FROM scott.emp
GROUP BY
  deptno
ORDER BY
  deptno
|_} : string
+--------+----------+-----------+
| deptno | sum_sal  | emp_count |
+--------+----------+-----------+
|     10 |  8750.00 |         3 |
|     20 | 10875.00 |         5 |
|     30 |  9400.00 |         6 |
+--------+----------+-----------+

# ----------------------------------------------------------------------------
# A3. WHERE removes rows before a measure is evaluated.
# Question: Without the clerks, what are the payroll and the headcount of
#   each department?
# Each measure sees only the rows that remain after WHERE.
# Spec: 7.3, G1 (8.2)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT deptno,
         AGG(sum_sal) AS sum_sal,
         AGG(emp_count) AS emp_count
  FROM scott_model.emp
  WHERE job <> 'CLERK'
  GROUP BY deptno
  ORDER BY deptno);
> {_|
SELECT
  deptno,
  SUM(sal) AS sum_sal,
  COUNT(*) AS emp_count
FROM scott.emp
WHERE
  job <> 'CLERK'
GROUP BY
  deptno
ORDER BY
  deptno
|_} : string
+--------+---------+-----------+
| deptno | sum_sal | emp_count |
+--------+---------+-----------+
|     10 | 7450.00 |         2 |
|     20 | 8975.00 |         3 |
|     30 | 8450.00 |         5 |
+--------+---------+-----------+

# ----------------------------------------------------------------------------
# A4. HAVING and ORDER BY can use a measure that is not selected.
# Question: Of the jobs that more than two employees have, which three have
#   the largest payroll?
# AGG() can appear in HAVING and ORDER BY, as any aggregate can. HAVING can
# use a measure that the SELECT list does not contain. HAVING removes ANALYST
# (6000, 2 employees) and PRESIDENT (5000, 1 employee), so CLERK (4150) is in
# the top three.
# Spec: 7.5
# ----------------------------------------------------------------------------
executeExpand(
  SELECT job, AGG(sum_sal) AS sum_sal
  FROM scott_model.emp
  GROUP BY job
  HAVING AGG(emp_count) > 2
  ORDER BY AGG(sum_sal) DESC
  LIMIT 3);
> {_|
SELECT
  job,
  SUM(sal) AS sum_sal
FROM scott.emp
GROUP BY
  job
HAVING
  COUNT(*) > 2
ORDER BY
  SUM(sal) DESC
LIMIT 3
|_} : string
+----------+---------+
| job      | sum_sal |
+----------+---------+
| MANAGER  | 8275.00 |
| SALESMAN | 5600.00 |
| CLERK    | 4150.00 |
+----------+---------+

# ----------------------------------------------------------------------------
# A5. Scalar operators apply to the values of AGG().
# Question: For each department, what is the salary per employee, computed in
#   two ways, and what is the total of salaries and commissions?
# Each AGG() gives one scalar value for each group. Scalar operators and
# functions then apply to these values. The ratio of two measures, sum_sal /
# emp_count, is equal to avg_sal. The CAST makes the division approximate:
# the scale of a division of two exact numerics is implementation-defined
# (README, "Result semantics"). COALESCE replaces the NULL commission total
# of departments 10 and 20.
# Spec: 7.2, 8.1
# ----------------------------------------------------------------------------
executeExpand(
  SELECT deptno,
         CAST(AGG(sum_sal) AS DOUBLE) / AGG(emp_count) AS sal_per_emp,
         AGG(avg_sal) AS avg_sal,
         AGG(sum_sal) + COALESCE(AGG(sum_comm), 0) AS total_pay
  FROM scott_model.emp
  GROUP BY deptno
  ORDER BY deptno);
> {_|
SELECT
  deptno,
  CAST(SUM(sal) AS DOUBLE) / COUNT(*) AS sal_per_emp,
  AVG(CAST(sal AS DOUBLE)) AS avg_sal,
  SUM(sal) + COALESCE(SUM(comm), 0) AS total_pay
FROM scott.emp
GROUP BY
  deptno
ORDER BY
  deptno
|_} : string
+--------+-------------+---------+-----------+
| deptno | sal_per_emp | avg_sal | total_pay |
+--------+-------------+---------+-----------+
|     10 |     2916.67 | 2916.67 |   8750.00 |
|     20 |     2175.00 | 2175.00 |  10875.00 |
|     30 |     1566.67 | 1566.67 |  11600.00 |
+--------+-------------+---------+-----------+

# ----------------------------------------------------------------------------
# A6. A measure follows the NULL rules of its aggregate.
# Question: For each department, how many employees are there, how many of
#   them have a commission, and what are the total and the average
#   commission?
# emp_count is COUNT(*) and counts every row. comm_count is COUNT(comm) and
# ignores NULL values. Departments 10 and 20 have no commission values, so
# sum_comm and avg_comm are NULL. In department 30, the commission of TURNER
# is 0.00, which is a value, so avg_comm is 2200 / 4.
# Spec: 8.1
# ----------------------------------------------------------------------------
executeExpand(
  SELECT deptno,
         AGG(emp_count) AS emp_count,
         AGG(comm_count) AS comm_count,
         AGG(sum_comm) AS sum_comm,
         AGG(avg_comm) AS avg_comm
  FROM scott_model.emp
  GROUP BY deptno
  ORDER BY deptno);
> {_|
SELECT
  deptno,
  COUNT(*) AS emp_count,
  COUNT(comm) AS comm_count,
  SUM(comm) AS sum_comm,
  AVG(CAST(comm AS DOUBLE)) AS avg_comm
FROM scott.emp
GROUP BY
  deptno
ORDER BY
  deptno
|_} : string
+--------+-----------+------------+----------+----------+
| deptno | emp_count | comm_count | sum_comm | avg_comm |
+--------+-----------+------------+----------+----------+
|     10 |         3 |          0 |          |          |
|     20 |         5 |          0 |          |          |
|     30 |         6 |          4 |  2200.00 |   550.00 |
+--------+-----------+------------+----------+----------+

# ----------------------------------------------------------------------------
# A7. A measure over no rows.
# Question: What are the headcount, the payroll, and the average salary of
#   department 40?
# No employee is in department 40. Each measure takes the empty-input value
# of its aggregate: 0 for COUNT, NULL for SUM and AVG.
# Spec: 8.1
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(emp_count) AS emp_count,
         AGG(sum_sal) AS sum_sal,
         AGG(avg_sal) AS avg_sal
  FROM scott_model.emp
  WHERE deptno = 40);
> {_|
SELECT
  COUNT(*) AS emp_count,
  SUM(sal) AS sum_sal,
  AVG(CAST(sal AS DOUBLE)) AS avg_sal
FROM scott.emp
WHERE
  deptno = 40
|_} : string
+-----------+---------+---------+
| emp_count | sum_sal | avg_sal |
+-----------+---------+---------+
|         0 |         |         |
+-----------+---------+---------+

# ----------------------------------------------------------------------------
# A8. GROUP BY ALL does not group by measures.
# Question: How many employees were hired in each year, and what is their
#   total salary?
# A measure is not a grouping column. GROUP BY ALL groups by the other
# expressions of the SELECT list: here, an expression on a field.
# Spec: 7.4
# ----------------------------------------------------------------------------
executeExpand(
  SELECT EXTRACT(YEAR FROM hiredate) AS hire_year,
         AGG(emp_count) AS emp_count,
         AGG(sum_sal) AS sum_sal
  FROM scott_model.emp
  GROUP BY ALL
  ORDER BY hire_year);
> {_|
SELECT
  EXTRACT(YEAR FROM hiredate) AS hire_year,
  COUNT(*) AS emp_count,
  SUM(sal) AS sum_sal
FROM scott.emp
GROUP BY ALL
ORDER BY
  hire_year
|_} : string
+-----------+-----------+----------+
| hire_year | emp_count | sum_sal  |
+-----------+-----------+----------+
|      1980 |         1 |   800.00 |
|      1981 |        10 | 22825.00 |
|      1982 |         1 |  1300.00 |
|      1987 |         2 |  4100.00 |
+-----------+-----------+----------+

# ----------------------------------------------------------------------------
# A9. ROLLUP evaluates a measure again for each grouping set.
# Question: What is the average salary of each department, and of the whole
#   company?
# On the total row, AGG(avg_sal) is the average over all 14 employees
# (2073.21). It is not the average of the three department averages
# (2219.44).
# Spec: 7.4, G1 (8.2)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT deptno,
         AGG(emp_count) AS emp_count,
         AGG(avg_sal) AS avg_sal
  FROM scott_model.emp
  GROUP BY ROLLUP (deptno)
  ORDER BY deptno NULLS LAST);
> {_|
SELECT
  deptno,
  COUNT(*) AS emp_count,
  AVG(CAST(sal AS DOUBLE)) AS avg_sal
FROM scott.emp
GROUP BY
  ROLLUP (
    deptno
  )
ORDER BY
  deptno NULLS LAST
|_} : string
+--------+-----------+---------+
| deptno | emp_count | avg_sal |
+--------+-----------+---------+
|     10 |         3 | 2916.67 |
|     20 |         5 | 2175.00 |
|     30 |         6 | 1566.67 |
|        |        14 | 2073.21 |
+--------+-----------+---------+

# ----------------------------------------------------------------------------
# A10. A CTE passes measures through and restricts their rows.
# Question: Counting only clerks and salesmen, what are the payroll and the
#   headcount of each department?
# The CTE passes the measures through without evaluating them. A rename does
# not change a measure. The WHERE clause of the CTE restricts the rows that
# the outer AGG() calls see.
# Spec: 7.1, 7.7, 8.1
# ----------------------------------------------------------------------------
executeExpand(
  WITH staff AS (
    SELECT deptno, sum_sal AS payroll, emp_count AS headcount
    FROM scott_model.emp
    WHERE job IN ('CLERK', 'SALESMAN'))
  SELECT deptno, AGG(payroll) AS payroll, AGG(headcount) AS headcount
  FROM staff
  GROUP BY deptno
  ORDER BY deptno);
> {_|
WITH staff AS (
  SELECT
    deptno,
    sal
  FROM scott.emp
  WHERE
    job IN ('CLERK', 'SALESMAN')
)
SELECT
  deptno,
  SUM(sal) AS payroll,
  COUNT(*) AS headcount
FROM staff
GROUP BY
  deptno
ORDER BY
  deptno
|_} : string
+--------+---------+-----------+
| deptno | payroll | headcount |
+--------+---------+-----------+
|     10 | 1300.00 |         1 |
|     20 | 1900.00 |         2 |
|     30 | 6550.00 |         5 |
+--------+---------+-----------+

# ----------------------------------------------------------------------------
# A11. AGG() in a scalar subquery in WHERE.
# Question: In each department, how many employees earn more than the company
#   average?
# AGG() cannot appear directly in WHERE, but a scalar subquery in WHERE can
# use it. The company average is 2073.21.
# Spec: 7.3
# ----------------------------------------------------------------------------
executeExpand(
  SELECT deptno, AGG(emp_count) AS emp_count
  FROM scott_model.emp
  WHERE sal > (SELECT AGG(avg_sal) FROM scott_model.emp)
  GROUP BY deptno
  ORDER BY deptno);
> {_|
SELECT
  deptno,
  COUNT(*) AS emp_count
FROM scott.emp
WHERE
  sal > (
    SELECT
      AVG(CAST(sal AS DOUBLE))
    FROM scott.emp
  )
GROUP BY
  deptno
ORDER BY
  deptno
|_} : string
+--------+-----------+
| deptno | emp_count |
+--------+-----------+
|     10 |         2 |
|     20 |         3 |
|     30 |         1 |
+--------+-----------+

# ----------------------------------------------------------------------------
# A12. An ordinary aggregate over AGG() values (two-stage aggregation).
# Question: What is the average payroll of a department, and what is the
#   average salary of an employee?
# The first branch averages the payroll of the three departments (29025 / 3).
# The second branch is the average salary of an employee. After AGG()
# evaluates the measures, the values are ordinary scalars, so the outer AVG
# and UNION ALL are valid. The outer AVG casts its argument, so its result is
# approximate (README, "Result semantics").
# Spec: A.3, 7.8
# ----------------------------------------------------------------------------
executeExpand(
  SELECT 'avg payroll per dept' AS metric,
         AVG(CAST(dept_sal AS DOUBLE)) AS amount
  FROM (SELECT deptno, AGG(sum_sal) AS dept_sal
        FROM scott_model.emp
        GROUP BY deptno) AS d
  UNION ALL
  SELECT 'avg salary per emp', AGG(avg_sal)
  FROM scott_model.emp
  ORDER BY metric);
> {_|
SELECT
  'avg payroll per dept' AS metric,
  AVG(CAST(dept_sal AS DOUBLE)) AS amount
FROM (
  SELECT
    deptno,
    SUM(sal) AS dept_sal
  FROM scott.emp
  GROUP BY
    deptno
) AS d
UNION ALL
SELECT
  'avg salary per emp',
  AVG(CAST(sal AS DOUBLE))
FROM scott.emp
ORDER BY
  metric
|_} : string
+----------------------+---------+
| metric               | amount  |
+----------------------+---------+
| avg payroll per dept | 9675.00 |
| avg salary per emp   | 2073.21 |
+----------------------+---------+

# ============================================================================
# Part B: joins
#
# A join can repeat a row of a measure's source (fan-out). An outer join can
# also add NULL-padded rows that come from no source row. AGG(m) aggregates
# each source row of m once and ignores NULL-padded rows (spec Section 8.1).
# The comments give the result of a plain aggregate over the joined rows
# ("naive") where it differs.
#
# The expansion applies the reference strategy of spec Section 9:
#   1. The CTE "joined" is the Ossie query's FROM, JOIN, and WHERE. For each
#      measure, it also carries the row-identity key (<alias>_k, which is the
#      primary key of the dataset) and the arguments of the aggregate.
#   2. The CTE "spine" has one row for each group: SELECT DISTINCT over the
#      grouping columns. A grand total has one group and needs no spine.
#   3. For each measure, a correlated subquery selects the joined rows of the
#      group, removes the rows where the key is NULL, reduces the rows to one
#      for each key (GROUP BY key), and then applies the aggregate.
#   4. Scalar expressions over AGG() results apply to the per-group values.
#
# B1-B3:   joins that repeat no row of the measure's source.
# B4-B8:   joins that repeat rows: fan-out and many-to-many.
# B9-B13:  one self-join query with each join type.
#
# Cases B5a, B8a and B9a to B13a join emp to pet; B8b joins emp to bonus
# and pet.
# B14-B17: one dept-emp query with inner and outer joins.
# B18-B20: filters, HAVING, and a filter relation, with fan-out.
# ============================================================================

# ----------------------------------------------------------------------------
# B1. A many-to-one join repeats no row of the measure.
# Question: What are the payroll and the headcount of each department, by
#   department name?
# Each employee matches one department, so the join repeats no emp row. The
# values are the per-department totals of A2.
# Spec: 7.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT d.dname,
         AGG(e.sum_sal) AS sum_sal,
         AGG(e.emp_count) AS emp_count
  FROM scott_model.emp AS e
  JOIN scott_model.dept AS d ON e.deptno = d.deptno
  GROUP BY d.dname
  ORDER BY d.dname);
> {_|
WITH joined AS (
  SELECT
    d.dname AS dname,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.emp AS e
  JOIN scott.dept AS d
    ON e.deptno = d.deptno
), spine AS (
  SELECT DISTINCT
    dname
  FROM joined
)
SELECT
  g.dname,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.dname IS NOT DISTINCT FROM g.dname
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.dname IS NOT DISTINCT FROM g.dname
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count
FROM spine AS g
ORDER BY
  g.dname
|_} : string
+------------+----------+-----------+
| dname      | sum_sal  | emp_count |
+------------+----------+-----------+
| ACCOUNTING |  8750.00 |         3 |
| RESEARCH   | 10875.00 |         5 |
| SALES      |  9400.00 |         6 |
+------------+----------+-----------+

# Note: B1 can be optimized. Each emp row joins to at most one dept row,
# because the join is on dept's primary key (deptno). So the join repeats
# no emp row, and a plain aggregate over the joined rows gives the same
# result as the reference strategy, without "joined", "spine" or a
# correlated subquery. (Spec Section 9 allows any strategy whose results
# equal those of the reference strategy.) The optimized query:
SELECT d.dname,
       SUM(e.sal) AS sum_sal,
       COUNT(*) AS emp_count
FROM scott.emp AS e
JOIN scott.dept AS d ON e.deptno = d.deptno
GROUP BY d.dname
ORDER BY d.dname;
+------------+----------+-----------+
| dname      | sum_sal  | emp_count |
+------------+----------+-----------+
| ACCOUNTING |  8750.00 |         3 |
| RESEARCH   | 10875.00 |         5 |
| SALES      |  9400.00 |         6 |
+------------+----------+-----------+

# ----------------------------------------------------------------------------
# B2. A filter on the joined relation restricts the measure.
# Question: For the employees in New York, what are the payroll and the
#   headcount of each job?
# A filter on dept removes emp rows from the input set, as a filter on emp
# does. Only the employees in NEW YORK remain.
# Spec: 7.6, G1 (8.2)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job,
         AGG(e.sum_sal) AS sum_sal,
         AGG(e.emp_count) AS emp_count
  FROM scott_model.emp AS e
  JOIN scott_model.dept AS d ON e.deptno = d.deptno
  WHERE d.loc = 'NEW YORK'
  GROUP BY e.job
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.emp AS e
  JOIN scott.dept AS d
    ON e.deptno = d.deptno
  WHERE
    d.loc = 'NEW YORK'
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count
FROM spine AS g
ORDER BY
  g.job
|_} : string
+-----------+---------+-----------+
| job       | sum_sal | emp_count |
+-----------+---------+-----------+
| CLERK     | 1300.00 |         1 |
| MANAGER   | 2450.00 |         1 |
| PRESIDENT | 5000.00 |         1 |
+-----------+---------+-----------+

# ----------------------------------------------------------------------------
# B3. A join to a top-N subquery acts as a filter.
# Question: In the two departments with the largest payroll, what is the
#   payroll of each job?
# The subquery selects the two departments with the largest payroll (20 and
# 30). The join to the subquery acts as a filter on emp, and the outer query
# reports the payroll of each job in those departments. The departments that
# the subquery ranks are the same values that the join matches (closure,
# Section 8.4).
# Spec: 7.6, 8.4, A.2
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job, AGG(e.sum_sal) AS sum_sal
  FROM scott_model.emp AS e
  JOIN (SELECT deptno
        FROM scott_model.emp
        GROUP BY deptno
        ORDER BY AGG(sum_sal) DESC
        LIMIT 2) AS t ON e.deptno = t.deptno
  GROUP BY e.job
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.emp AS e
  JOIN (
    SELECT
      deptno
    FROM scott.emp
    GROUP BY
      deptno
    ORDER BY
      SUM(sal) DESC
    LIMIT 2
  ) AS t
    ON e.deptno = t.deptno
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal
FROM spine AS g
ORDER BY
  g.job
|_} : string
+----------+---------+
| job      | sum_sal |
+----------+---------+
| ANALYST  | 6000.00 |
| CLERK    | 2850.00 |
| MANAGER  | 5825.00 |
| SALESMAN | 5600.00 |
+----------+---------+

# ----------------------------------------------------------------------------
# B4. Fan-out: a measure of the "one" side counts each of its rows once.
# Question: For each job, how many departments have it, and how many
#   employees have it?
# The join repeats each dept row once for each employee in the department.
# AGG(d.dept_count) counts each department once in each group, so the result
# is the number of departments that have the job. A plain COUNT(*) over the
# joined rows gives 2, 4, 3, 1, 4. AGG(e.emp_count) gives the same values,
# because the join repeats no emp row.
# Spec: 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job,
         AGG(d.dept_count) AS dept_count,
         AGG(e.emp_count) AS emp_count
  FROM scott_model.emp AS e
  JOIN scott_model.dept AS d ON e.deptno = d.deptno
  GROUP BY e.job
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    d.deptno AS d_k,
    e.empno AS e_k
  FROM scott.emp AS e
  JOIN scott.dept AS d
    ON e.deptno = d.deptno
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count
FROM spine AS g
ORDER BY
  g.job
|_} : string
+-----------+------------+-----------+
| job       | dept_count | emp_count |
+-----------+------------+-----------+
| ANALYST   |          1 |         2 |
| CLERK     |          3 |         4 |
| MANAGER   |          3 |         3 |
| PRESIDENT |          1 |         1 |
| SALESMAN  |          1 |         4 |
+-----------+------------+-----------+

# ----------------------------------------------------------------------------
# B5. Fan-out in a self-join: each manager is counted once.
# Question: For each job, how many employees have a manager, how many
#   managers do they report to, and what is the total salary of those
#   managers?
# e is the employee and m is the manager. The join repeats each manager row
# once for each report. AGG(m.sum_sal) counts the salary of each manager once
# in each group. The 4 salesmen all report to BLAKE, so the result is 2850,
# and a plain SUM(m.sal) gives 11400. The 4 clerks report to 4 different
# managers, so the two values are the same (11300). A plain SUM(m.sal) by job
# gives 5950, 11300, 15000, 11400.
# Spec: 7.6, 8.1, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job,
         AGG(e.emp_count) AS emp_count,
         AGG(m.emp_count) AS managers,
         AGG(m.sum_sal) AS managers_sal
  FROM scott_model.emp AS e
  JOIN scott_model.emp AS m ON e.mgr = m.empno
  GROUP BY e.job
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    e.empno AS e_k,
    m.empno AS m_k,
    m.sal AS m_sal
  FROM scott.emp AS e
  JOIN scott.emp AS m
    ON e.mgr = m.empno
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.m_k
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.m_k
    ) AS x
  ) AS managers,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.m_sal) AS sal
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.m_k
    ) AS x
  ) AS managers_sal
FROM spine AS g
ORDER BY
  g.job
|_} : string
+----------+-----------+----------+--------------+
| job      | emp_count | managers | managers_sal |
+----------+-----------+----------+--------------+
| ANALYST  |         2 |        1 |      2975.00 |
| CLERK    |         4 |        4 |     11300.00 |
| MANAGER  |         3 |        1 |      5000.00 |
| SALESMAN |         4 |        1 |      2850.00 |
+----------+-----------+----------+--------------+

# ----------------------------------------------------------------------------
# B5a. Fan-out: the owners' salary, by species of pet.
# The join repeats each owner once for each of their pets of the species.
# JONES has two cats, so the join repeats JONES in the CAT group, and
# AGG(e.sum_sal) counts JONES's salary once. Naive SUM(e.sal) for CAT is
# 11950. SUM(DISTINCT e.sal) is no remedy: it gives 5975, because FORD and
# SCOTT have the same salary.
# Spec: 7.6, 8.1, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT p.species,
         AGG(e.emp_count) AS owners,
         AGG(e.sum_sal) AS owners_sal,
         AGG(p.pet_count) AS pets,
         AGG(p.sum_age) AS sum_age
  FROM scott_model.emp AS e
  JOIN scott_model.pet AS p ON p.empno = e.empno
  GROUP BY p.species
  ORDER BY p.species);
> {_|
WITH joined AS (
  SELECT
    p.species AS species,
    e.empno AS e_k,
    e.sal AS e_sal,
    p.pname AS p_k,
    p.age AS p_age
  FROM scott.emp AS e
  JOIN scott.pet AS p
    ON p.empno = e.empno
), spine AS (
  SELECT DISTINCT
    species
  FROM joined
)
SELECT
  g.species,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.e_k
    ) AS x
  ) AS owners,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.e_k
    ) AS x
  ) AS owners_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.p_k
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.p_k
    ) AS x
  ) AS pets,
  (
    SELECT
      SUM(x.age)
    FROM (
      SELECT
        ANY_VALUE(j.p_age) AS age
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.p_k
    ) AS x
  ) AS sum_age
FROM spine AS g
ORDER BY
  g.species
|_} : string
+---------+--------+------------+------+---------+
| species | owners | owners_sal | pets | sum_age |
+---------+--------+------------+------+---------+
| CAT     |      3 |    8975.00 |    4 |      15 |
| DOG     |      2 |    4575.00 |    2 |      14 |
| HAMSTER |      1 |    1100.00 |    1 |       1 |
+---------+--------+------------+------+---------+

# ----------------------------------------------------------------------------
# B6. Fan-out through a range join.
# Question: For each department, how many employees are there, and how many
#   salary grades do their salaries fall into?
# The join condition can be any predicate over fields, not only an equality.
# Each employee matches one salary grade, and one grade can match many
# employees. AGG(s.grade_count) counts each grade once in each department, so
# it gives the number of distinct grades in the department. A plain COUNT(*)
# over the joined rows gives 3, 5, 6.
# Spec: 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.deptno,
         AGG(e.emp_count) AS emp_count,
         AGG(s.grade_count) AS grade_count
  FROM scott_model.emp AS e
  JOIN scott_model.salgrade AS s ON e.sal BETWEEN s.losal AND s.hisal
  GROUP BY e.deptno
  ORDER BY e.deptno);
> {_|
WITH joined AS (
  SELECT
    e.deptno AS deptno,
    e.empno AS e_k,
    s.grade AS s_k
  FROM scott.emp AS e
  JOIN scott.salgrade AS s
    ON e.sal BETWEEN s.losal AND s.hisal
), spine AS (
  SELECT DISTINCT
    deptno
  FROM joined
)
SELECT
  g.deptno,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.deptno IS NOT DISTINCT FROM g.deptno
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.s_k
      FROM joined AS j
      WHERE
        j.s_k IS NOT NULL AND j.deptno IS NOT DISTINCT FROM g.deptno
      GROUP BY
        j.s_k
    ) AS x
  ) AS grade_count
FROM spine AS g
ORDER BY
  g.deptno
|_} : string
+--------+-----------+-------------+
| deptno | emp_count | grade_count |
+--------+-----------+-------------+
|     10 |         3 |           3 |
|     20 |         5 |           2 |
|     30 |         6 |           4 |
+--------+-----------+-------------+

# ----------------------------------------------------------------------------
# B7. Fan-out in a three-way join.
# Question: For each salary grade, how many employees are in it, what is
#   their total salary, and how many departments have one of them?
# emp joins to dept and to salgrade, and the group is the salary grade.
# AGG(d.dept_count) gives the number of departments that have an employee in
# the grade. The join repeats each dept row once for each of its employees in
# the grade. A plain COUNT(*) over the joined rows gives 3, 3, 2, 5, 1.
# Spec: 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT s.grade,
         AGG(e.emp_count) AS emp_count,
         AGG(e.sum_sal) AS sum_sal,
         AGG(d.dept_count) AS dept_count
  FROM scott_model.emp AS e
  JOIN scott_model.dept AS d ON e.deptno = d.deptno
  JOIN scott_model.salgrade AS s ON e.sal BETWEEN s.losal AND s.hisal
  GROUP BY s.grade
  ORDER BY s.grade);
> {_|
WITH joined AS (
  SELECT
    s.grade AS grade,
    e.empno AS e_k,
    e.sal AS e_sal,
    d.deptno AS d_k
  FROM scott.emp AS e
  JOIN scott.dept AS d
    ON e.deptno = d.deptno
  JOIN scott.salgrade AS s
    ON e.sal BETWEEN s.losal AND s.hisal
), spine AS (
  SELECT DISTINCT
    grade
  FROM joined
)
SELECT
  g.grade,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.grade IS NOT DISTINCT FROM g.grade
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.grade IS NOT DISTINCT FROM g.grade
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL AND j.grade IS NOT DISTINCT FROM g.grade
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count
FROM spine AS g
ORDER BY
  g.grade
|_} : string
+-------+-----------+----------+------------+
| grade | emp_count | sum_sal  | dept_count |
+-------+-----------+----------+------------+
|     1 |         3 |  2850.00 |          2 |
|     2 |         3 |  3800.00 |          2 |
|     3 |         2 |  3100.00 |          1 |
|     4 |         5 | 14275.00 |          3 |
|     5 |         1 |  5000.00 |          1 |
+-------+-----------+----------+------------+

# ----------------------------------------------------------------------------
# B8. A many-to-many join repeats rows on both sides (chasm trap).
# Question: For each department, what is the payroll, and how many colleagues
#   are there, when each employee is joined to every colleague in the
#   department?
# Each employee is joined to every colleague in the same department, which
# gives 3 x 3, 5 x 5, and 6 x 6 joined rows. Both sides repeat. Each measure
# still counts each of its source rows once. A plain SUM(e.sal) gives 26250,
# 54375, 56400, and a plain COUNT(*) gives 9, 25, 36.
# Spec: 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.deptno,
         AGG(e.sum_sal) AS sum_sal,
         AGG(c.emp_count) AS colleagues
  FROM scott_model.emp AS e
  JOIN scott_model.emp AS c ON e.deptno = c.deptno
  GROUP BY e.deptno
  ORDER BY e.deptno);
> {_|
WITH joined AS (
  SELECT
    e.deptno AS deptno,
    e.empno AS e_k,
    e.sal AS e_sal,
    c.empno AS c_k
  FROM scott.emp AS e
  JOIN scott.emp AS c
    ON e.deptno = c.deptno
), spine AS (
  SELECT DISTINCT
    deptno
  FROM joined
)
SELECT
  g.deptno,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.deptno IS NOT DISTINCT FROM g.deptno
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.c_k
      FROM joined AS j
      WHERE
        j.c_k IS NOT NULL AND j.deptno IS NOT DISTINCT FROM g.deptno
      GROUP BY
        j.c_k
    ) AS x
  ) AS colleagues
FROM spine AS g
ORDER BY
  g.deptno
|_} : string
+--------+----------+------------+
| deptno | sum_sal  | colleagues |
+--------+----------+------------+
|     10 |  8750.00 |          3 |
|     20 | 10875.00 |          5 |
|     30 |  9400.00 |          6 |
+--------+----------+------------+

# ----------------------------------------------------------------------------
# B8a. Many-to-many join: employees and their manager's pets.
# Both sides repeat: JONES has three pets and two reports (FORD and SCOTT),
# so the join repeats each of JONES's pets twice and each of FORD and SCOTT
# three times. Naive SUM(e.sal) for CAT is 13900, naive COUNT(*) is 6, and
# naive SUM(p.age) is 22.
# Spec: 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT p.species,
         AGG(e.emp_count) AS reports,
         AGG(e.sum_sal) AS reports_sal,
         AGG(p.pet_count) AS pets,
         AGG(p.sum_age) AS sum_age
  FROM scott_model.emp AS e
  JOIN scott_model.pet AS p ON p.empno = e.mgr
  GROUP BY p.species
  ORDER BY p.species);
> {_|
WITH joined AS (
  SELECT
    p.species AS species,
    e.empno AS e_k,
    e.sal AS e_sal,
    p.pname AS p_k,
    p.age AS p_age
  FROM scott.emp AS e
  JOIN scott.pet AS p
    ON p.empno = e.mgr
), spine AS (
  SELECT DISTINCT
    species
  FROM joined
)
SELECT
  g.species,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.e_k
    ) AS x
  ) AS reports,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.e_k
    ) AS x
  ) AS reports_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.p_k
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.p_k
    ) AS x
  ) AS pets,
  (
    SELECT
      SUM(x.age)
    FROM (
      SELECT
        ANY_VALUE(j.p_age) AS age
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.p_k
    ) AS x
  ) AS sum_age
FROM spine AS g
ORDER BY
  g.species
|_} : string
+---------+---------+-------------+------+---------+
| species | reports | reports_sal | pets | sum_age |
+---------+---------+-------------+------+---------+
| CAT     |       4 |     7900.00 |    4 |      15 |
| DOG     |       2 |     6000.00 |    1 |       7 |
+---------+---------+-------------+------+---------+

# ----------------------------------------------------------------------------
# B8b. Chasm trap: bonus and pet both join to emp.
# Question: For each employee that has a bonus, what is their salary, how
#   many bonuses do they have and what is their total, and how many pets do
#   they have?
# bonus and pet are each on the "many" side of a join to emp, so the join
# repeats each of an employee's bonuses once for each of their pets, and each
# pet once for each bonus. JONES has two bonuses and three pets, which gives 6
# joined rows: naive SUM(e.sal) is 17850, naive COUNT(*) is 6, naive
# SUM(b.comm) is 1500, and naive COUNT(p.pname) is 6. KING has one bonus and
# no pet; the LEFT JOIN keeps him, with no pets.
# Spec: 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.ename,
         AGG(e.sum_sal) AS sal,
         AGG(b.bonus_count) AS bonuses,
         AGG(b.sum_bonus) AS bonus,
         AGG(p.pet_count) AS pets
  FROM scott_model.bonus AS b
  JOIN scott_model.emp AS e ON b.ename = e.ename
  LEFT JOIN scott_model.pet AS p ON p.empno = e.empno
  GROUP BY e.ename
  ORDER BY e.ename);
> {_|
WITH joined AS (
  SELECT
    e.ename AS ename,
    e.empno AS e_k,
    e.sal AS e_sal,
    b.ename AS b_ename,
    b.job AS b_job,
    b.sal AS b_sal,
    b.comm AS b_comm,
    p.pname AS p_k
  FROM scott.bonus AS b
  JOIN scott.emp AS e
    ON b.ename = e.ename
  LEFT JOIN scott.pet AS p
    ON p.empno = e.empno
), spine AS (
  SELECT DISTINCT
    ename
  FROM joined
)
SELECT
  g.ename,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.ename IS NOT DISTINCT FROM g.ename
      GROUP BY
        j.e_k
    ) AS x
  ) AS sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.b_ename,
        j.b_job,
        j.b_sal,
        j.b_comm
      FROM joined AS j
      WHERE
        j.b_ename IS NOT NULL AND j.ename IS NOT DISTINCT FROM g.ename
      GROUP BY
        j.b_ename,
        j.b_job,
        j.b_sal,
        j.b_comm
    ) AS x
  ) AS bonuses,
  (
    SELECT
      SUM(x.comm)
    FROM (
      SELECT
        ANY_VALUE(j.b_comm) AS comm
      FROM joined AS j
      WHERE
        j.b_ename IS NOT NULL AND j.ename IS NOT DISTINCT FROM g.ename
      GROUP BY
        j.b_ename,
        j.b_job,
        j.b_sal,
        j.b_comm
    ) AS x
  ) AS bonus,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.p_k
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL AND j.ename IS NOT DISTINCT FROM g.ename
      GROUP BY
        j.p_k
    ) AS x
  ) AS pets
FROM spine AS g
ORDER BY
  g.ename
|_} : string
+-------+---------+---------+---------+------+
| ename | sal     | bonuses | bonus   | pets |
+-------+---------+---------+---------+------+
| JONES | 2975.00 |       2 |  500.00 |    3 |
| KING  | 5000.00 |       1 | 1000.00 |    0 |
+-------+---------+---------+---------+------+

# ----------------------------------------------------------------------------
# B9-B13. One self-join query with each join type.
#
# e is the employee and m is the manager, joined on e.mgr = m.empno. Both
# sides have rows that do not match:
#   * KING has no manager, so KING has no match on the e side.
#   * 8 employees manage nobody, so they have no match on the m side.
# The join type decides which source rows reach each measure. The join never
# inflates a measure, and NULL-padded rows add nothing:
#
#   join type   joined rows   e_count  e_sal     m_count  m_sal
#   INNER       13            13       24025.00  6        19275.00
#   LEFT        14            14       29025.00  6        19275.00
#   RIGHT       21            13       24025.00  14       29025.00
#   FULL        22            14       29025.00  14       29025.00
#   CROSS       196           14       29025.00  14       29025.00
#
# Naive SUM(m.sal) for the INNER join is 43650: KING's salary is counted 3
# times and BLAKE's 5 times.
#
# Cases B9a to B13a run one query that joins emp to pet, on
# p.empno = e.empno, with each join type. Both sides have rows that do not
# match: 9 employees have no pet, and TRAMP has no owner.
#
#   join type   joined rows   e_count  e_sal     p_count  p_age
#   INNER         7            5       11675.00  7        30
#   LEFT         16           14       29025.00  7        30
#   RIGHT         8            5       11675.00  8        34
#   FULL         17           14       29025.00  8        34
#   CROSS       112           14       29025.00  8        34
#
# Naive SUM(e.sal) for the INNER join is 17625: JONES's salary is counted 3
# times.
# Spec: 7.6, 8.1, G2 (8.3), A.6
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# B9. INNER JOIN: each side keeps only its matched rows.
# Question: Over the employees that have a manager and the managers that have
#   a report, how many employees are on each side, and what do they earn?
# B9 to B13 run one self-join query with each join type. e is the employee
# and m is the manager, joined on e.mgr = m.empno. KING has no manager, and 8
# employees manage nobody. The join type decides which rows reach each
# measure. No join type makes a measure count a row twice, and NULL-padded
# rows add nothing.
#
# INNER gives 13 joined rows. KING is not on the e side, and the 8 employees
# that manage nobody are not on the m side. A plain SUM(m.sal) gives 43650,
# because it counts the salary of KING 3 times and the salary of BLAKE 5
# times.
# Spec: 7.6, 8.1, G2 (8.3), A.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(e.emp_count) AS e_count,
         AGG(e.sum_sal) AS e_sal,
         AGG(m.emp_count) AS m_count,
         AGG(m.sum_sal) AS m_sal
  FROM scott_model.emp AS e
  JOIN scott_model.emp AS m ON e.mgr = m.empno);
> {_|
WITH joined AS (
  SELECT
    e.empno AS e_k,
    e.sal AS e_sal,
    m.empno AS m_k,
    m.sal AS m_sal
  FROM scott.emp AS e
  JOIN scott.emp AS m
    ON e.mgr = m.empno
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS e_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS e_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.m_k
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL
      GROUP BY
        j.m_k
    ) AS x
  ) AS m_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.m_sal) AS sal
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL
      GROUP BY
        j.m_k
    ) AS x
  ) AS m_sal
