  SELECT
    e.empno AS e_k,
    e.sal AS e_sal,
    m.empno AS m_k,
    m.sal AS m_sal
  FROM scott.emp AS e
  CROSS JOIN scott.emp AS m
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
